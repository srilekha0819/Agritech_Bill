# ==============================================================================
# LangBill AI - Production & Development Environment Configuration
# ==============================================================================
# Copy this file to '.env' and adjust the values according to your environment.
# DO NOT commit the actual '.env' file containing real secrets to version control.

# --- Application Server Configuration ---
FLASK_ENV=production
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# --- Upload Limits ---
# Maximum uploaded file size in Megabytes (default: 25 MB)
MAX_CONTENT_LENGTH_MB=25

# --- Compute Device Configuration ---
# Options: auto (detects CUDA GPU if available, else CPU), cuda, or cpu
DEVICE=auto

# --- Custom Model & Storage Directories (Optional) ---
# Uncomment and set absolute paths if storing weights or uploads outside the project root
# SAVED_MODELS_DIR=./saved_models
# UPLOADS_DIR=./uploads

# --- Production WSGI Server Settings (Waitress / Gunicorn) ---
WSGI_WORKERS=4
WSGI_THREADS=4

